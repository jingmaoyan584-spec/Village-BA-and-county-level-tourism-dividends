. 
. foreach did of local donor_ids {
  2.     use `baseline_weights', clear
  3.     quietly summarize baseline_weight if county_id == `did', meanonly
  4.     local weight = r(mean)
  5.     quietly levelsof county if county_id == `did', local(dname) clean
  6. 
.     tempfile fit
  7.     use `panel', clear
  8.     drop if county_id == `did'
  9.     quietly synth ln_rev ln_vis ln_pcgdp ln_pop ln_budrev ln_budexp ///
>         ln_rev(2015) ln_rev(2016) ln_rev(2017) ln_rev(2018) ///
>         ln_rev(2019) ln_rev(2020) ln_rev(2021), ///
>         trunit(`trid') trperiod(2022) xperiod(2015(1)2021) ///
>         mspeperiod(2015(1)2021) resultsperiod(2015(1)2024) ///
>         keep("`fit'") replace
 10. 
.     use `fit', clear
 11.     capture confirm variable year
 12.     if _rc rename _time year
 13.     gen double gap = _Y_treated - _Y_synthetic
 14.     gen double sqgap = gap^2
 15.     quietly summarize sqgap if inrange(year, 2015, 2021), meanonly
 16.     local pre = sqrt(r(mean))
 17.     quietly summarize sqgap if inrange(year, 2022, 2024), meanonly
 18.     local post = sqrt(r(mean))
 19.     quietly summarize gap if year == 2022, meanonly
 20.     local g22 = r(mean)
 21.     quietly summarize gap if year == 2023, meanonly
 22.     local g23 = r(mean)
 23.     quietly summarize gap if year == 2024, meanonly
 24.     local g24 = r(mean)
 25.     local gpost = (`g23' + `g24') / 2
 26.     post `results_post' (`did') ("`dname'") (`weight') (`pre') (`post') ///
>         (`post'/`pre') (`g22') (`g23') (`g24') (`gpost') ///
>         (100 * (exp(`g22') - 1)) (100 * (exp(`gpost') - 1))
 27. }

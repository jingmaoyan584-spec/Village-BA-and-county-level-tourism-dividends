. scalar p = 2 * (1 - normal(abs(e(ATT) / e(se))))

. scalar lo = e(ATT) - invnormal(.975) * e(se)

. scalar hi = e(ATT) + invnormal(.975) * e(se)

. post `levelpost' ("2022") (e(ATT)/10) (e(se)/10) (lo/10) (hi/10) (p) (1000)

. restore


. ********************************************************************************
. * 2. SDID: remove 2020-2021 for every county; placebo inference, 1,000 reps
. ********************************************************************************
. 
. tempname sdidpost

. tempfile sdid_results

. postfile `sdidpost' str16 outcome str18 period double att se ci_lo_95 ci_hi_95 pvalue reps using `sdid_results', replace
(file C:\Users\ASUS\AppData\Local\Temp\ST_3e50_000005.tmp not found)

. 
. foreach yvar in ln_rev ln_vis {
  2.     * Immediate-breakout window: 2015-2019 pre-treatment plus 2022.
.     use `panel', clear
  3.     keep if inrange(year, 2015, 2019) | year == 2022
  4.     gen treated_2022 = county_id == `trid' & year == 2022
  5.     sdid `yvar' county_id year treated_2022, vce(placebo) reps(1000) seed(`seed')
  6.     scalar p = 2 * (1 - normal(abs(e(ATT) / e(se))))
  7.     scalar lo = e(ATT) - invnormal(.975) * e(se)
  8.     scalar hi = e(ATT) + invnormal(.975) * e(se)
  9.     post `sdidpost' ("`yvar'") ("2022") (e(ATT)) (e(se)) (lo) (hi) (p) (1000)
 10. 
.     * Institutionalized-expansion window: pre-2019 plus 2023-2024.
.     use `panel', clear
 11.     keep if inrange(year, 2015, 2019) | inrange(year, 2023, 2024)
 12.     egen time_id = group(year)
 13.     gen treated_post = county_id == `trid' & year >= 2023
 14.     sdid `yvar' county_id time_id treated_post, vce(placebo) reps(1000) seed(`seed')
 15.     scalar p = 2 * (1 - normal(abs(e(ATT) / e(se))))
 16.     scalar lo = e(ATT) - invnormal(.975) * e(se)
 17.     scalar hi = e(ATT) + invnormal(.975) * e(se)
 18.     post `sdidpost' ("`yvar'") ("2023-2024") (e(ATT)) (e(se)) (lo) (hi) (p) (1000)
 19. }

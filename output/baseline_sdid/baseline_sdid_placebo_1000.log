. 
. use "`paneldta'", clear
(Qiandongnan county panel 2015-2024 analysis sample, Stata-ready)

. keep if inrange(year, 2015, 2024)
(0 observations deleted)

. capture confirm variable ln_rev

. if _rc gen ln_rev = ln_tour_rev

. capture confirm variable ln_vis

. if _rc gen ln_vis = ln_tour_vis

. xtset county_id year

Panel variable: county_id (strongly balanced)
 Time variable: year, 2015 to 2024
         Delta: 1 unit

. 
. tempfile panel results

. save `panel', replace
(file C:\Users\ASUS\AppData\Local\Temp\ST_3e50_000001.tmp not found)
file C:\Users\ASUS\AppData\Local\Temp\ST_3e50_000001.tmp saved as .dta format

. 
. tempname posth

. postfile `posth' str24 outcome str12 period ///
>     double att placebo_se ci_lo_95 ci_hi_95 pvalue effect_pct reps ///
>     using `results', replace
(file C:\Users\ASUS\AppData\Local\Temp\ST_3e50_000002.tmp not found)

. 
. foreach yvar in ln_rev ln_vis {
  2.     local label "Tourism revenue"
  3.     if "`yvar'" == "ln_vis" local label "Tourist visitors"
  4. 
.     * Immediate breakout year: 2015-2022, with treatment in 2022.
.     use `panel', clear
  5.     keep if inrange(year, 2015, 2022)
  6.     gen treated_2022 = county_id == `trid' & year == 2022
  7.     sdid `yvar' county_id year treated_2022, ///
>         vce(placebo) reps(`reps') seed(`seed')
  8.     scalar p = 2 * (1 - normal(abs(e(ATT) / e(se))))
  9.     scalar lo = e(ATT) - invnormal(.975) * e(se)
 10.     scalar hi = e(ATT) + invnormal(.975) * e(se)
 11.     post `posth' ("`label'") ("2022") (e(ATT)) (e(se)) ///
>         (lo) (hi) (p) (100 * (exp(e(ATT)) - 1)) (`reps')
 12. 
.     * Institutional-expansion stage: omit 2022 and treat 2023-2024 as post.
.     use `panel', clear
 13.     drop if year == 2022
 14.     egen time_id = group(year)
 15.     gen treated_post = county_id == `trid' & year >= 2023
 16.     sdid `yvar' county_id time_id treated_post, ///
>         vce(placebo) reps(`reps') seed(`seed')
 17.     scalar p = 2 * (1 - normal(abs(e(ATT) / e(se))))
 18.     scalar lo = e(ATT) - invnormal(.975) * e(se)
 19.     scalar hi = e(ATT) + invnormal(.975) * e(se)
 20.     post `posth' ("`label'") ("2023-2024") (e(ATT)) (e(se)) ///
>         (lo) (hi) (p) (100 * (exp(e(ATT)) - 1)) (`reps')
 21. }

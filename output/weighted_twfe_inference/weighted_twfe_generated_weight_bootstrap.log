. 
. * Compute the baseline point estimates from the current analysis data. These
. * values must not be hard-coded because post-treatment outcomes can be revised.
. preserve

. foreach yvar in ln_rev ln_vis {
  2.     use `basepanel', clear
  3.     merge m:1 county_id using `weights', nogen keepusing(matching_weight)
  4.     replace matching_weight = 1 if county_id == `trid'
  5.     capture drop treated did_2022 did_post
  6.     gen treated = county_id == `trid'
  7.     gen did_2022 = treated * (year == 2022)
  8.     gen did_post = treated * (year >= 2023)
  9.     quietly regress `yvar' did_2022 did_post ln_pcgdp ln_pop ln_budrev ln_budexp ///
>         i.county_id i.year [aw=matching_weight]
 10.     if "`yvar'" == "ln_rev" {
 11.         scalar base_rev_2022 = _b[did_2022]
 12.         scalar base_rev_post = _b[did_post]
 13.     }
 14.     else {
 15.         scalar base_vis_2022 = _b[did_2022]
 16.         scalar base_vis_post = _b[did_post]
 17.     }
 18. }

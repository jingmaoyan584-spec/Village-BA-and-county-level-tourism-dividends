. ********************************************************************************
. * 2. Full-procedure donor bootstrap, including regenerated matching weights.
. ********************************************************************************
. capture program drop kernel_twfe_boot

. program define kernel_twfe_boot, rclass
  1.     syntax , Outcome(name)
  2.     tempfile donor_draw bootpanel br bv bf bw
  3.     use "$TAIJIANG_BOOT_PANEL", clear
  4.     keep if county_id != $TAIJIANG_BOOT_TRID
  5.     bsample, cluster(county_id) idcluster(panel_id)
  6.     save `donor_draw', replace
  7. 
.     use "$TAIJIANG_BOOT_PANEL", clear
  8.     keep if county_id == $TAIJIANG_BOOT_TRID
  9.     gen long panel_id = 0
 10.     append using `donor_draw'
 11.     save `bootpanel', replace
 12. 
.     use `bootpanel', clear
 13.     keep if inrange(year, 2015, 2021)
 14.     statsby slope_rev=_b[year], by(panel_id) clear: regress ln_rev year
 15.     save `br', replace
 16.     use `bootpanel', clear
 17.     keep if inrange(year, 2015, 2021)
 18.     statsby slope_vis=_b[year], by(panel_id) clear: regress ln_vis year
 19.     save `bv', replace
 20. 
.     use `bootpanel', clear
 21.     keep if inrange(year, 2015, 2021)
 22.     collapse (mean) mean_ln_rev=ln_rev mean_ln_vis=ln_vis mean_ln_pcgdp=ln_pcgdp ///
>         mean_ln_pop=ln_pop mean_ln_budrev=ln_budrev mean_ln_budexp=ln_budexp, by(panel_id)
 23.     merge 1:1 panel_id using `br', nogen
 24.     merge 1:1 panel_id using `bv', nogen
 25.     foreach v in mean_ln_rev slope_rev mean_ln_vis slope_vis mean_ln_pcgdp mean_ln_pop mean_ln_budrev mean_ln_budexp {
 26.         egen z_`v' = std(`v')
 27.         quietly summarize z_`v' if panel_id == 0, meanonly
 28.         scalar target_`v' = r(mean)
 29.     }
 30.     gen distance = sqrt((z_mean_ln_rev-target_mean_ln_rev)^2 + ///
>         (z_slope_rev-target_slope_rev)^2 + (z_mean_ln_vis-target_mean_ln_vis)^2 + ///
>         (z_slope_vis-target_slope_vis)^2 + (z_mean_ln_pcgdp-target_mean_ln_pcgdp)^2 + ///
>         (z_mean_ln_pop-target_mean_ln_pop)^2 + (z_mean_ln_budrev-target_mean_ln_budrev)^2 + ///
>         (z_mean_ln_budexp-target_mean_ln_budexp)^2)
 31.     gen weight = exp(-distance)
 32.     replace weight = . if panel_id == 0
 33.     quietly summarize weight, meanonly
 34.     replace weight = weight/r(sum)
 35.     keep panel_id weight
 36.     save `bw', replace
 37. 
.     use `bootpanel', clear
 38.     merge m:1 panel_id using `bw', nogen
 39.     replace weight = 1 if panel_id == 0
 40.     capture drop treated did_2022 did_post
 41.     gen treated = panel_id == 0
 42.     gen did_2022 = treated * (year == 2022)
 43.     gen did_post = treated * (year >= 2023)
 44.     quietly regress `outcome' did_2022 did_post ln_pcgdp ln_pop ln_budrev ln_budexp ///
>         i.panel_id i.year [aw=weight]
 45.     return scalar b_2022 = _b[did_2022]
 46.     return scalar b_post = _b[did_post]
 47. end

. 
. use `basepanel', clear
(Qiandongnan county panel 2015-2024 analysis sample, Stata-ready)


. postfile `infpost' str16 outcome str12 period double baseline_beta bootstrap_se ci_lo_95 ci_hi_95 using `inference', replace
(file C:\Users\ASUS\AppData\Local\Temp\ST_3e50_000009.tmp not found)

. foreach out in "Log revenue" "Log visitors" {
  2.     preserve
  3.     keep if outcome == "`out'"
  4.     foreach term in 2022 post {
  5.         quietly summarize b_`term', detail
  6.         scalar bse = r(sd)
  7.         quietly centile b_`term', centile(2.5 97.5)
  8.         scalar clo = r(c_1)
  9.         scalar chi = r(c_2)
 10.         if "`out'" == "Log revenue" & "`term'" == "2022" scalar base = base_rev_2022
 11.         if "`out'" == "Log revenue" & "`term'" == "post" scalar base = base_rev_post
 12.         if "`out'" == "Log visitors" & "`term'" == "2022" scalar base = base_vis_2022
 13.         if "`out'" == "Log visitors" & "`term'" == "post" scalar base = base_vis_post
 14.         if "`term'" == "2022" post `infpost' ("`out'") ("2022") (base) (bse) (clo) (chi)
 15.         else post `infpost' ("`out'") ("2023-2024") (base) (bse) (clo) (chi)
 16.     }
 17.     restore
 18. }

(file C:\Users\ASUS\AppData\Local\Temp\ST_3e50_000006.tmp not found)

. 
. foreach yvar in ln_rev ln_vis {
  2.     if "`yvar'" == "ln_rev" {
  3.         local other "ln_vis"
  4.         local outcome "Tourism revenue"
  5.         local predictors "ln_vis ln_pcgdp ln_pop ln_budrev ln_budexp ln_rev_2015 ln_rev_2016 ln_rev_2017 ln_rev_2018 ln_rev_2019 ln_rev_2020 ln_rev_2021"
  6.     }
  7.     else {
  8.         local other "ln_rev"
  9.         local outcome "Tourist visitors"
 10.         local predictors "ln_rev ln_pcgdp ln_pop ln_budrev ln_budexp ln_vis_2015 ln_vis_2016 ln_vis_2017 ln_vis_2018 ln_vis_2019 ln_vis_2020 ln_vis_2021"
 11.     }
 12.     tempfile fit
 13.     use `panel', clear
 14.     quietly synth `yvar' `other' ln_pcgdp ln_pop ln_budrev ln_budexp ///
>         `yvar'(2015) `yvar'(2016) `yvar'(2017) `yvar'(2018) ///
>         `yvar'(2019) `yvar'(2020) `yvar'(2021), ///
>         trunit(`trid') trperiod(2022) xperiod(2015(1)2021) ///
>         mspeperiod(2015(1)2021) resultsperiod(2015(1)2024) ///
>         keep("`fit'") replace
 15. 
.     matrix W = e(W_weights)
 16.     clear
 17.     svmat double W
 18.     rename W1 county_id
 19.     rename W2 donor_weight
 20.     quietly levelsof county_id, local(donorids)
 21.     foreach did of local donorids {
 22.         quietly summarize donor_weight if county_id == `did', meanonly
 23.         post `donorpost' ("`outcome'") (`did') (r(mean))
 24.     }
 25. 
.     * synth returns a symmetric V matrix. Its diagonal contains the predictor
.     * weights, whose scale is arbitrary; report both raw and sum-normalized values.
.     matrix Vdiag = vecdiag(e(V_matrix))'
 26.     clear
 27.     svmat double Vdiag
 28.     rename Vdiag1 predictor_weight_raw
 29.     quietly summarize predictor_weight_raw, meanonly
 30.     gen double predictor_weight_normalized = predictor_weight_raw / r(sum)
 31.     gen str32 predictor = ""
 32.     local p = 0
 33.     foreach pname of local predictors {
 34.         local ++p
 35.         replace predictor = "`pname'" in `p'
 36.     }
 37.     assert _N == `p'
 38.     forvalues j = 1/`=_N' {
 39.         post `predpost' ("`outcome'") (predictor[`j']) ///
>             (predictor_weight_raw[`j']) (predictor_weight_normalized[`j'])
 40.     }
 41. 
.     use `fit', clear
 42.     capture confirm variable year
 43.     if _rc rename _time year
 44.     gen double gap = _Y_treated - _Y_synthetic
 45.     gen double sqgap = gap^2
 46.     quietly summarize sqgap if inrange(year, 2015, 2021), meanonly
 47.     scalar pre = sqrt(r(mean))
 48.     quietly summarize sqgap if inrange(year, 2022, 2024), meanonly
 49.     scalar post = sqrt(r(mean))
 50.     quietly summarize gap if year == 2022, meanonly
 51.     scalar g22 = r(mean)
 52.     quietly summarize gap if inrange(year, 2023, 2024), meanonly
 53.     scalar gpost = r(mean)
 54.     post `sumpost' ("`outcome'") (pre) (post) (post/pre) (g22) (gpost) ///
>         (100*(exp(g22)-1)) (100*(exp(gpost)-1))
 55.     forvalues yy = 2015/2024 {
 56.         quietly summarize _Y_treated if year == `yy', meanonly
 57.         scalar actual = r(mean)
 58.         quietly summarize _Y_synthetic if year == `yy', meanonly
 59.         scalar synthetic = r(mean)
 60.         quietly summarize gap if year == `yy', meanonly
 61.         post `pathpost' ("`outcome'") (`yy') (actual) (synthetic) (r(mean))
 62.     }
 63. }

. capture program drop make_kernel_weights

. program define make_kernel_weights
  1.     syntax , Paneldata(string) Firstyear(integer) Lastyear(integer) Treatid(integer) Saveas(string)
  2. 
.     tempfile slope_rev slope_vis
  3.     use "`paneldata'", clear
  4.     keep if inrange(year, `firstyear', `lastyear')
  5.     statsby slope_rev=_b[year], by(county_id) clear: regress ln_rev year
  6.     save `slope_rev', replace
  7. 
.     use "`paneldata'", clear
  8.     keep if inrange(year, `firstyear', `lastyear')
  9.     statsby slope_vis=_b[year], by(county_id) clear: regress ln_vis year
 10.     save `slope_vis', replace
 11. 
.     use "`paneldata'", clear
 12.     keep if inrange(year, `firstyear', `lastyear')
 13.     collapse (mean) mean_ln_rev=ln_rev mean_ln_vis=ln_vis mean_ln_pcgdp=ln_pcgdp ///
>         mean_ln_pop=ln_pop mean_ln_budrev=ln_budrev mean_ln_budexp=ln_budexp, by(county_id)
 14.     merge 1:1 county_id using `slope_rev', nogen
 15.     merge 1:1 county_id using `slope_vis', nogen
 16. 
.     foreach v in mean_ln_rev slope_rev mean_ln_vis slope_vis mean_ln_pcgdp mean_ln_pop mean_ln_budrev mean_ln_budexp {
 17.         egen z_`v' = std(`v')
 18.         quietly summarize z_`v' if county_id == `treatid', meanonly
 19.         scalar tr_`v' = r(mean)
 20.     }
 21.     gen double distance = sqrt( ///
>         (z_mean_ln_rev-tr_mean_ln_rev)^2 + (z_slope_rev-tr_slope_rev)^2 + ///
>         (z_mean_ln_vis-tr_mean_ln_vis)^2 + (z_slope_vis-tr_slope_vis)^2 + ///
>         (z_mean_ln_pcgdp-tr_mean_ln_pcgdp)^2 + (z_mean_ln_pop-tr_mean_ln_pop)^2 + ///
>         (z_mean_ln_budrev-tr_mean_ln_budrev)^2 + (z_mean_ln_budexp-tr_mean_ln_budexp)^2)
 22.     gen double matching_weight = exp(-distance)
 23.     replace matching_weight = . if county_id == `treatid'
 24.     quietly summarize matching_weight, meanonly
 25.     replace matching_weight = matching_weight / r(sum)
 26.     keep county_id matching_weight
 27.     save "`saveas'", replace
 28. end


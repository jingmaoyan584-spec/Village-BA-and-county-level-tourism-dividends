. foreach specification in baseline covid_excluded {
  2.     if "`specification'" == "baseline" {
  3.         local panel_label "Panel A: Baseline"
  4.         local weightfile `weights_baseline'
  5.         local sample_condition "inrange(year, 2015, 2024)"
  6.     }
  7.     else {
  8.         local panel_label "Panel B: COVID-excluded"
  9.         local weightfile `weights_covid'
 10.         local sample_condition "!inlist(year, 2020, 2021)"
 11.     }
 12. 
.     foreach yvar in ln_rev ln_vis {
 13.         use `panel', clear
 14.         keep if `sample_condition'
 15.         merge m:1 county_id using `weightfile', nogen
 16.         replace matching_weight = 1 if county_id == `trid'
 17.         assert !missing(matching_weight)
 18.         capture drop treated did_2022 did_post
 19.         gen byte treated = county_id == `trid'
 20.         gen byte did_2022 = treated * (year == 2022)
 21.         gen byte did_post = treated * (year >= 2023)
 22. 
.         quietly regress `yvar' did_2022 did_post ln_pcgdp ln_pop ln_budrev ln_budexp ///
>             i.county_id i.year [aw=matching_weight], vce(cluster county_id)
 23. 
.         if "`yvar'" == "ln_rev" local outcome_label "Log tourism revenue"
 24.         else local outcome_label "Log tourist visitors"
 25.         foreach term in did_2022 did_post ln_pcgdp ln_pop ln_budrev ln_budexp {
 26.             scalar b = _b[`term']
 27.             scalar se = _se[`term']
 28.             scalar crit = invttail(e(df_r), .025)
 29.             scalar lo = b - crit * se
 30.             scalar hi = b + crit * se
 31.             scalar p_cluster = 2 * ttail(e(df_r), abs(b / se))
 32.             scalar p_webb = .
 33.             if inlist("`term'", "did_2022", "did_post") {
 34.                 quietly boottest `term', cluster(county_id) reps(`reps') seed(20260820) weight(webb) nograph
 35.                 scalar p_webb = r(p)
 36.                 display as result "S7 `specification' `outcome_label' `term': Webb wild-cluster p = " %9.6f p_webb
 37.             }
 38.             local term_label ""
 39.             if "`term'" == "did_2022" local term_label "Treatment x 2022"
 40.             if "`term'" == "did_post"  local term_label "Treatment x Post (2023-2024)"
 41.             if "`term'" == "ln_pcgdp"  local term_label "Log per-capita GDP"
 42.             if "`term'" == "ln_pop"    local term_label "Log resident population"
 43.             if "`term'" == "ln_budrev" local term_label "Log budget revenue"
 44.             if "`term'" == "ln_budexp" local term_label "Log budget expenditure"
 45.             post `resultpost' ("`specification'") ("`outcome_label'") ("`term_label'") ///
>                 (b) (se) (lo) (hi) (p_cluster) (p_webb) (e(N)) (e(r2)) (e(r2_a))
 46.         }
 47.     }
 48. }
